# References & extracted design assets (kept local, out of git)
assets/reference/
*.png
*.jpg
*.jpeg
*.webp
*.har
*.css.extracted
.env
.env.*

# Track application branding and icon assets
!assets/images/**
!linux/runner/assets/**
!android/app/src/main/res/**
!ios/Runner/Assets.xcassets/**
!macos/Runner/Assets.xcassets/**
!web/favicon.png
!web/icons/**
# Deliberate, sanitized review screenshots linked from audit reports
!docs/visual-audit/**/*.png

# Dart / Flutter build artifacts
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies

# Scratch files
scratch/

# Editor and Flutter-generated local files
.idea/
*.iml
android/local.properties

# Local signing material must never be committed
**/key.properties
*.keystore
*.jks

# Python verification helpers
__pycache__/
*.pyc
